# Copy this file to .env and fill in the values
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_PASSWORD=your-admin-override-password-here

# Voyage AI — used to embed transcripts and search queries for retrieval
# (replaces a local sentence-transformers model to keep memory usage low)
VOYAGE_API_KEY=your-voyage-api-key-here

# Vimeo OTT (VHX) — used to verify a subscriber's email against the
# LvR Mentoring ON Demand product before granting chat access
VHX_API_KEY=your-vhx-api-key-here
VHX_PRODUCT_ID=264536

# Magic-link login — SECRET_KEY signs login links and "remember this device"
# cookies. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
APP_URL=http://localhost:8502
# RESEND_API_KEY=your-resend-api-key-here
# RESEND_FROM_EMAIL=LvR Mentoring <noreply@yourdomain.com>

# Optional: override the default transcripts directory
# TRANSCRIPTS_DIR=/Users/LvR/zoom_transcripts

# Only needed on a fresh deploy where transcripts/ and reference/ aren't
# present locally (this code repo is public; the course content lives in a
# separate private repo, cloned at boot using this token). Not needed for
# local dev, since those folders already exist here.
# CONTENT_REPO=lumonfortlvr/lvr-gpt-content
# CONTENT_REPO_TOKEN=your-fine-grained-github-token-here
